xi = [1, 2, 3, 4];
yi = [2, 4, 5, 7];

// Полиномиальная интерполяция
Pn = polyfit(xi, yi, length(xi)-1); // Степень на единицу меньше количества точек

// Вычисление значений на сетке
xx_p = linspace(min(xi), max(xi), 100);
yy_p = horner(Pn, xx_p);

// Визуализация
scf();
clf();
plot(xx_p, yy_p, 'b-', xi, yi, 'or'); // Синяя линия - интерполяция, красные точки - исходные данные
xlabel('x');
ylabel('y');
title('Полиномиальная аппроксимация');
legend('Интерполирующий полином', 'Исходные точки', 'Расположение', 'best');
